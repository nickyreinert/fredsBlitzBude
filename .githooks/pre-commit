#!/bin/bash
# ================================================================
# Zählt bei jedem Commit automatisch die Versionsnummer hoch
# (letzte Stelle in js/version.js, z.B. 1.0.7 → 1.0.8).
# Aktiv durch: git config core.hooksPath .githooks
# ================================================================
set -e
cd "$(git rev-parse --show-toplevel)"

DATEI="js/version.js"
ALT=$(sed -n "s/.*SPIEL_VERSION = '\([0-9]*\.[0-9]*\.[0-9]*\)'.*/\1/p" "$DATEI")
if [ -z "$ALT" ]; then
  echo "pre-commit: Version in $DATEI nicht gefunden – nichts geändert." >&2
  exit 0
fi
NEU=$(echo "$ALT" | awk -F. '{ printf "%d.%d.%d", $1, $2, $3 + 1 }')

# -i.bak funktioniert auf macOS und Linux gleich
sed -i.bak "s/SPIEL_VERSION = '$ALT'/SPIEL_VERSION = '$NEU'/" "$DATEI" && rm -f "$DATEI.bak"
git add "$DATEI"
echo "Version: $ALT → $NEU"
